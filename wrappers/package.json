{
  "name": "hexfrontier",
  "productName": "Hexfrontier",
  "version": "1.0.0",
  "private": true,
  "description": "Hexfrontier · 4X táctico por turnos en hexágonos",
  "author": "Hexfrontier",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "stage": "node scripts/stage-web.js",
    "start": "npm run stage && electron .",
    "start:devtools": "npm run stage && electron . --devtools",
    "dist": "npm run stage && electron-builder --win nsis --x64",
    "dist:dir": "npm run stage && electron-builder --dir",
    "steam": "npm run stage && electron-builder --win --x64 --dir",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run stage && cap sync",
    "cap:android": "npm run stage && cap sync android && cap open android",
    "cap:ios": "npm run stage && cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  }
}
